* text=auto
*.cpp text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.md text eol=lf
Makefile text eol=lf
.clang-format text eol=lf
.githooks/* text eol=lf
# Preserve the professor's files byte for byte, including their CRLF endings.
*.sln -text
*.vcxproj -text
*.vcxproj.filters -text
*.sln whitespace=cr-at-eol
*.vcxproj whitespace=cr-at-eol
*.vcxproj.filters whitespace=cr-at-eol
# Keep vendor headers in their original Windows line endings as well.
visual_studio/include/** -text whitespace=cr-at-eol
original_vs_project/include/** -text whitespace=cr-at-eol
original_vs_project/main.cpp -text whitespace=cr-at-eol
*.dll binary
*.lib binary
*.exe binary
